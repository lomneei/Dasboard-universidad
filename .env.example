# Copia este archivo a .env y completa con los valores de tu proyecto Supabase
# (Supabase Dashboard -> Project Settings -> API)
# Nota: Vite exige el prefijo VITE_ para exponer variables al frontend.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Google Calendar (solo lectura). OAuth Client ID tipo "Web application"
# de Google Cloud Console -> APIs & Services -> Credentials.
# Orígenes JavaScript autorizados: http://localhost:5173 (+ tu dominio).
# No necesita redirect URI (usa popup de Google Identity Services).
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
